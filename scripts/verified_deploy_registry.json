{
  "schema": 1,
  "releases": {
    "kavelnummer-thumbnails-release.yml": {
      "preflight": ".github/workflows/kavel-release-readonly-preflight.yml",
      "artifact_prefix": "kavel-preflight-sha256",
      "confirmation": "DEPLOY KAVELNUMMER THUMBNAILS WITH ROLLBACK",
      "paths": [
        "catalogus-public/admin/kavel.php",
        "private/lot_form.php",
        "catalogus-public/admin/admin.css",
        "catalogus-public/admin/index.php"
      ],
      "hash_inputs": [
        "expected_kavel",
        "expected_lot_form",
        "expected_css",
        "expected_index"
      ]
    },
    "auction-organisation-release.yml": {
      "preflight": ".github/workflows/registered-release-auto-readonly.yml",
      "artifact_prefix": "auction-organisation-preflight",
      "confirmation": "DEPLOY AUCTION ORGANISATION WITH ROLLBACK",
      "paths": [
        "private/auction_organisation.php",
        "catalogus-public/admin/veiling-organisatie.php",
        "private/bootstrap.php"
      ],
      "hash_inputs": [
        "expected_helper",
        "expected_page",
        "expected_bootstrap"
      ],
      "manifest_file": "auction-organisation-preflight.json",
      "allow_absent": [
        "private/auction_organisation.php",
        "catalogus-public/admin/veiling-organisatie.php"
      ]
    }
  }
}
