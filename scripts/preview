#!/bin/sh
# Usage: sh scripts/preview start|test|status|diagnose|stop
set -eu
ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
COMPOSE="$ROOT/dev/preview/compose.yaml"
PROJECT=veiling-local-ui-preview
CFG="$ROOT/private/config.php"
check_config() {
  if [ -e "$CFG" ] || [ -L "$CFG" ]; then
    if [ ! -f "$CFG" ] || [ -L "$CFG" ] ||
       ! grep -q 'local-preview-only-nonproduction' "$CFG" ||
       ! grep -q "'host' => 'preview-db'" "$CFG"; then
      echo 'STOP: private/config.php belongs to another environment. Use an isolated worktree.' >&2
      exit 1
    fi
  fi
}
dc() { docker compose --project-name "$PROJECT" -f "$COMPOSE" "$@"; }
# Read-only diagnostic: a reused Compose project can still mount another worktree.
# This explains stale UI even after the preview branch was fast-forwarded.
diagnose_preview() {
  check_config
  command -v docker >/dev/null 2>&1 || { echo 'STOP: Docker CLI ontbreekt.' >&2; return 1; }
  docker info >/dev/null 2>&1 || { echo 'STOP: Docker Engine draait niet. Start Docker Desktop.' >&2; return 1; }
  printf 'Huidige worktree: %s\n' "$ROOT"
  printf 'Huidige branch: %s\n' "$(git branch --show-current)"
  printf 'Huidige commit: %s\n' "$(git rev-parse HEAD)"
  cid=$(dc ps -q preview-web)
  if [ -z "$cid" ]; then
    echo 'STOP: preview-web container draait niet. Geen actieve code te controleren.' >&2
    return 1
  fi
  mounted=$(docker inspect "$cid" --format '{{range .Mounts}}{{if eq .Destination "/app"}}{{.Source}}{{end}}{{end}}')
  printf 'Docker /app bron: %s\n' "$mounted"
  if [ -z "$mounted" ]; then
    echo 'STOP: geen bind mount op /app gevonden.' >&2
    return 1
  fi
  if command -v shasum >/dev/null 2>&1; then
    local_php=$(shasum -a 256 "$ROOT/catalogus-public/admin/kavel.php" | awk '{print $1}')
    local_js=$(shasum -a 256 "$ROOT/catalogus-public/admin/lot-photo-preview.js" | awk '{print $1}')
  else
    command -v sha256sum >/dev/null 2>&1 || { echo 'STOP: sha256 tool ontbreekt.' >&2; return 1; }
    local_php=$(sha256sum "$ROOT/catalogus-public/admin/kavel.php" | awk '{print $1}')
    local_js=$(sha256sum "$ROOT/catalogus-public/admin/lot-photo-preview.js" | awk '{print $1}')
  fi
  live_php=$(dc exec -T preview-web php -r 'echo hash_file("sha256", "/app/catalogus-public/admin/kavel.php");')
  live_js=$(dc exec -T preview-web php -r 'echo hash_file("sha256", "/app/catalogus-public/admin/lot-photo-preview.js");')
  if [ "$local_php" != "$live_php" ] || [ "$local_js" != "$live_js" ]; then
    echo 'FOUT: de actieve Docker-container voert NIET dezelfde kavel- en uploadcode uit als deze worktree.' >&2
    echo 'Controleer eerst de /app bron en bewaar bestaande lokale uploads voordat je containers hermaakt.' >&2
    return 1
  fi
  echo 'OK: Docker gebruikt dezelfde kavel- en uploadcode als deze worktree.'
  # Read-only check: the mounted code may be current while its isolated MySQL
  # fixture still lacks the newer artist columns.
  if ! dc exec -T preview-web php -r '
    require "private/bootstrap.php";
    if (getenv("LOCAL_PREVIEW_ISOLATED") !== "1"
        || cfg("setup_key") !== "local-preview-only-nonproduction"
        || db()->query("SELECT DATABASE()")->fetchColumn() !== "auction_test") {
      fwrite(STDERR, "STOP: database valt buiten de geïsoleerde preview.\n");
      exit(1);
    }
    foreach (["artist_name", "artist_url"] as $field) {
      $st = db()->query("SHOW COLUMNS FROM lots LIKE " . db()->quote($field));
      if (!$st->fetch()) {
        fwrite(STDERR, "ONTBREEKT: lots." . $field . ". Voer uit: docker compose --project-name veiling-local-ui-preview -f dev/preview/compose.yaml exec preview-web php dev/preview/seed.php\n");
        exit(1);
      }
    }
    $table = db()->query("SHOW TABLES LIKE " . db()->quote("lot_categories"))->fetchColumn();
    if ($table === false) {
      fwrite(STDERR, "ONTBREEKT: lot_categories in preview-MySQL. Voer uit: docker compose --project-name veiling-local-ui-preview -f dev/preview/compose.yaml exec -T preview-web php dev/preview/seed.php\\n");
      exit(1);
    }
    echo "OK: kunstenaarsvelden en categorieën aanwezig in geïsoleerde previewdatabase.\\n";
  '; then
    return 1
  fi

}
case "${1:-}" in
  start)
    command -v docker >/dev/null || { echo 'Docker Desktop is required.' >&2; exit 1; }
    docker compose version >/dev/null
    branch=$(git branch --show-current)
    if [ -z "$branch" ]; then
      # GitHub checks out the PR merge commit detached; accept only that isolated CI event.
      [ "${GITHUB_ACTIONS:-}" = true ] &&
      [ "${GITHUB_EVENT_NAME:-}" = pull_request ] &&
      [ -n "${GITHUB_HEAD_REF:-}" ] &&
      [ "${GITHUB_HEAD_REF:-}" != main ] || {
        echo 'STOP: detached HEAD is allowed only for GitHub PR CI.' >&2
        exit 1
      }
    elif [ "$branch" = main ]; then
      echo 'STOP: use a development branch/worktree, not main.' >&2
      exit 1
    fi
    check_config
    dc up -d --build --wait
    printf 'Local preview: http://localhost:8080\nAdmin: http://localhost:8080/admin/login.php\n'
    printf 'Synthetic login: ci-admin@example.invalid / ci-password-not-a-real-secret\n'
    ;;
  test)
    check_config
    diagnose_preview
    command -v npm >/dev/null || { echo 'Node.js/npm required for Playwright.' >&2; exit 1; }
    if [ ! -x dev/preview/node_modules/.bin/playwright ]; then
      npm --prefix dev/preview install --no-save --no-package-lock --no-audit --no-fund playwright@1.57.0
    fi
    # Avoid the known macOS Chromium-download hang. Use locally installed Chrome.
    # CI runs visual_test.cjs directly after its own pinned browser install.
    if [ "$(uname -s)" = Darwin ]; then
      if [ -n "${PREVIEW_BROWSER_EXECUTABLE:-}" ]; then
        [ -x "$PREVIEW_BROWSER_EXECUTABLE" ] || {
          echo "Browser not executable: $PREVIEW_BROWSER_EXECUTABLE" >&2
          exit 1
        }
      elif [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
        PREVIEW_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      elif [ -x "$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
        PREVIEW_BROWSER_EXECUTABLE="$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      elif [ -x "/Applications/Chromium.app/Contents/MacOS/Chromium" ]; then
        PREVIEW_BROWSER_EXECUTABLE="/Applications/Chromium.app/Contents/MacOS/Chromium"
      else
        echo 'No installed Chrome/Chromium browser found on macOS.' >&2
        echo 'Install Google Chrome or set PREVIEW_BROWSER_EXECUTABLE to a valid browser path.' >&2
        echo 'The preview test will not retry the previously stuck Chromium download.' >&2
        exit 1
      fi
      export PREVIEW_BROWSER_EXECUTABLE
      echo "Preview tests: using browser $PREVIEW_BROWSER_EXECUTABLE"
    else
      if [ -z "${PREVIEW_BROWSER_EXECUTABLE:-}" ]; then
        dev/preview/node_modules/.bin/playwright install chromium
      fi
    fi
    node tests/lot_photo_upload_target_test.cjs
    node tests/lot_unsaved_warning_test.cjs
    node dev/preview/visual_test.cjs
    ;;
  status)
    dc ps
    diagnose_preview
    ;;
  diagnose)
    diagnose_preview
    ;;
  stop)
    check_config
    dc down --volumes --remove-orphans
    if [ -f "$CFG" ]; then rm -- "$CFG"; fi
    echo 'Synthetic database removed; local preview stopped.'
    ;;
  *)
    echo 'Usage: sh scripts/preview start|test|status|diagnose|stop' >&2
    exit 2
    ;;
esac
