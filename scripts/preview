#!/bin/sh
# Usage: sh scripts/preview start|test|status|stop
set -eu
ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
COMPOSE="$ROOT/dev/preview/compose.yaml"
PROJECT=veiling-local-ui-preview
CFG="$ROOT/private/config.php"
check_config() {
  if [ -e "$CFG" ] || [ -L "$CFG" ]; then
    if [ ! -f "$CFG" ] || [ -L "$CFG" ] ||
       ! grep -q 'local-preview-only-nonproduction' "$CFG" ||
       ! grep -q "'host' => 'preview-db'" "$CFG"; then
      echo 'STOP: private/config.php belongs to another environment. Use an isolated worktree.' >&2
      exit 1
    fi
  fi
}
dc() { docker compose --project-name "$PROJECT" -f "$COMPOSE" "$@"; }
case "${1:-}" in
  start)
    command -v docker >/dev/null || { echo 'Docker Desktop is required.' >&2; exit 1; }
    docker compose version >/dev/null
    branch=$(git branch --show-current)
    if [ -z "$branch" ]; then
      # GitHub checks out the PR merge commit detached; accept only that isolated CI event.
      [ "${GITHUB_ACTIONS:-}" = true ] &&
      [ "${GITHUB_EVENT_NAME:-}" = pull_request ] &&
      [ -n "${GITHUB_HEAD_REF:-}" ] &&
      [ "${GITHUB_HEAD_REF:-}" != main ] || {
        echo 'STOP: detached HEAD is allowed only for GitHub PR CI.' >&2
        exit 1
      }
    elif [ "$branch" = main ]; then
      echo 'STOP: use a development branch/worktree, not main.' >&2
      exit 1
    fi
    check_config
    dc up -d --build --wait
    printf 'Local preview: http://localhost:8080\nAdmin: http://localhost:8080/admin/login.php\n'
    printf 'Synthetic login: ci-admin@example.invalid / ci-password-not-a-real-secret\n'
    ;;
  test)
    check_config
    command -v npm >/dev/null || { echo 'Node.js/npm required for Playwright.' >&2; exit 1; }
    if [ ! -x dev/preview/node_modules/.bin/playwright ]; then
      npm --prefix dev/preview install --no-save --no-package-lock --no-audit --no-fund playwright@1.57.0
    fi
    # Avoid the known macOS Chromium-download hang. Use locally installed Chrome.
    # CI runs visual_test.cjs directly after its own pinned browser install.
    if [ "$(uname -s)" = Darwin ]; then
      if [ -n "${PREVIEW_BROWSER_EXECUTABLE:-}" ]; then
        [ -x "$PREVIEW_BROWSER_EXECUTABLE" ] || {
          echo "Browser not executable: $PREVIEW_BROWSER_EXECUTABLE" >&2
          exit 1
        }
      elif [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
        PREVIEW_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      elif [ -x "$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
        PREVIEW_BROWSER_EXECUTABLE="$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      elif [ -x "/Applications/Chromium.app/Contents/MacOS/Chromium" ]; then
        PREVIEW_BROWSER_EXECUTABLE="/Applications/Chromium.app/Contents/MacOS/Chromium"
      else
        echo 'No installed Chrome/Chromium browser found on macOS.' >&2
        echo 'Install Google Chrome or set PREVIEW_BROWSER_EXECUTABLE to a valid browser path.' >&2
        echo 'The preview test will not retry the previously stuck Chromium download.' >&2
        exit 1
      fi
      export PREVIEW_BROWSER_EXECUTABLE
      echo "Preview tests: using browser $PREVIEW_BROWSER_EXECUTABLE"
    else
      if [ -z "${PREVIEW_BROWSER_EXECUTABLE:-}" ]; then
        dev/preview/node_modules/.bin/playwright install chromium
      fi
    fi
    node dev/preview/visual_test.cjs
    ;;
  status)
    dc ps
    ;;
  stop)
    check_config
    dc down --volumes --remove-orphans
    if [ -f "$CFG" ]; then rm -- "$CFG"; fi
    echo 'Synthetic database removed; local preview stopped.'
    ;;
  *)
    echo 'Usage: sh scripts/preview start|test|status|stop' >&2
    exit 2
    ;;
esac
